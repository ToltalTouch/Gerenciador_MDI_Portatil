<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaMdiApp"
        x:Class="AvaloniaMdiApp.MainWindow"
        Title="Gerenciador MDI Portátil"
        Icon="avares://AvaloniaMdiApp/Assets/app-icon.png"
        Width="1024" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="MenuItem > PathIcon">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
    </Style>
  </Window.Styles>

  <LayoutTransformControl Name="RootScaleHost">
    <Grid Name="MainRootGrid">
      <DockPanel Name="RootDock" Background="#0F172A">
        <Border Name="TopBar" DockPanel.Dock="Top" Height="38" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1">
          <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Name="ColorFilterPanel" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Name="LblColorFilter" Text="Filtro:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
              <Button Name="BtnClearColorFilter" Content="Todas" Height="22" Padding="8,0" FontSize="11" CornerRadius="11" Click="ClearColorFilter_Click"/>
              <StackPanel Name="ColorFilterDotsPanel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Abas rápidas de Workspaces à direita -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="520">
                <StackPanel Name="WorkspaceTabsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
              </ScrollViewer>
              <Button Name="BtnAddWorkspace"
                      Height="26"
                      Padding="8,0"
                      CornerRadius="5"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="Criar novo Workspace"
                      Click="NovoWorkspace_Click">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="10" Height="10" Foreground="#CBD5E1"/>
                  <TextBlock Text="Novo Workspace" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Barra Lateral Retrátil de Widgets -->
        <Border Name="LeftSidebar" DockPanel.Dock="Left" Width="60" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <DockPanel>
            <Button Name="BtnToggleSidebar"
                    DockPanel.Dock="Top"
                    Height="40"
                    Margin="6,8,6,4"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Alternar Menu Lateral&#x0a;Expanda para exibir os nomes de todos os widgets ou recolha para modo compacto com ícones."
                    Click="ToggleSidebar_Click">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{x:Static local:AppIcons.Menu}" Width="18" Height="18" Foreground="#CBD5E1"/>
                <TextBlock Name="LblSidebarTitle" Text="Widgets" FontSize="13" FontWeight="SemiBold" IsVisible="False" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border DockPanel.Dock="Top" Height="1" Margin="10,2,10,6" Background="#27272A"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Spacing="4" Margin="6,4,6,8">
              <Border Height="1" Margin="4,0,4,4" Background="#27272A"/>
              <Button Name="BtnSideSalvarTudo" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Salvar Tudo&#x0a;Salva instantaneamente o estado de todas as janelas, notas, planilhas e o Workspace atual." Click="SalvarTodasJanelas_Click">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Save}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSideSalvarTudo" Text="Salvar Tudo" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Name="BtnSideExtrair" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Central de Exportação e Importação&#x0a;Exporte o Workspace em PDF, PNG, HTML interativo ou pacote portátil (.mdiws/.zip), e importe notas, planilhas e mídias.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Download}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSideExtrair" Text="Exportar / Extrair" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="RightEdgeAlignedBottom">
                    <MenuItem Header="Demonstração em PDF..." Click="ExportarWorkspacePdf_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.PdfFile}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Imagem do Workspace (.png)..." Click="ExportarWorkspacePng_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Image}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Relatório Interativo (.html)..." Click="ExportarWorkspaceHtml_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Globe}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Extrair Janela Ativa (.txt / .csv / Mídia)..." Click="ExportarJanelaAtiva_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ExternalLink}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exportar Workspace (.mdiws)..." Click="ExportarWorkspaceJson_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Download}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exportar Pacote Completo com Mídias (.zip)..." Click="ExportarWorkspaceZip_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Save}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Importar Arquivo para o Workspace (.txt, .csv, Mídia)..." Click="ImportarArquivoParaWorkspace_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Upload}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Importar Workspace / Pacote (.mdiws, .zip)..." Click="ImportarWorkspace_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Folder}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Sincronizar Backup no Google Drive..." Click="SincronizarGoogleDriveManual_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Upload}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Abrir Pasta do Google Drive" Click="AbrirPastaGoogleDrive_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ExternalLink}"/></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <Button Name="BtnSidePreferencias" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Preferências do Sistema&#x0a;Ajuste o tema visual (claro/escuro e cores), notificações, escala de exibição, tamanho das janelas e atualizações." Click="AbrirConfiguracoes_Click">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Settings}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSidePreferencias" Text="Preferências" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Vertical" Spacing="6" Margin="6,2,6,8">
                <Button Name="BtnSideNotas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Bloco de Notas&#x0a;Crie anotações com suporte a formatação avançada (negrito, itálico, tamanhos de fonte) por linha e salvamento no Workspace." Click="AbrirBlocoDeNotas_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Note}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideNotas" Text="Bloco de Notas" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Name="BtnSideListas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Lista de Marcação&#x0a;Gerencie tarefas com caixas de seleção, defina cores individuais por item e conecte tarefas a anotações ou datas no calendário." Click="AbrirChecklist_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Checklist}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideListas" Text="Lista de Marcação" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Name="BtnSidePlanilhas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Planilhas&#x0a;Grade de cálculo interativa com suporte a fórmulas matemáticas (SOMA, MÉDIA, etc.), formatação condicional e exportação/importação CSV." Click="AbrirPlanilha_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Spreadsheet}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSidePlanilhas" Text="Planilhas" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Name="BtnSideGaleria" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Galeria de Mídias&#x0a;Visualize miniaturas de imagens e vídeos, abra mídias em janelas flutuantes dedicadas ou defina imagens como fundo do Workspace.">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Image}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideGaleria" Text="Galeria" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop" Opening="MenuModulo_Opening">
                      <MenuItem Header="Nova Galeria" Click="AbrirGaleria_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Plus}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Name="MenuGaleriaSalvas" Header="Abrir Galeria Existente">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Folder}"/></MenuItem.Icon>
                      </MenuItem>
                      <Separator/>
                      <MenuItem Header="Abrir Imagem em Janela..." Click="AbrirImagemAvulsa_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Image}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Abrir Vídeo em Janela..." Click="AbrirVideoAvulso_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Video}"/></MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>

                <Button Name="BtnSideNavegador" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Navegador Web&#x0a;Abra páginas da internet diretamente no sistema em janelas multitarefa, com atalhos rápidos para Google, YouTube, GitHub e Wikipédia.">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Globe}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideNavegador" Text="Navegador" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop" Opening="MenuModulo_Opening">
                      <MenuItem Header="Novo Navegador Web" Click="AbrirNavegador_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Globe}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Name="MenuNavegadorSalvos" Header="Navegadores Salvos">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Folder}"/></MenuItem.Icon>
                      </MenuItem>
                      <Separator/>
                      <MenuItem Header="Abrir Google" Click="AbrirNavegadorGoogle_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Search}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Abrir YouTube" Click="AbrirNavegadorYouTube_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Play}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Abrir GitHub" Click="AbrirNavegadorGitHub_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Code}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Abrir Wikipédia" Click="AbrirNavegadorWikipedia_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Book}"/></MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>

                <Button Name="BtnSideFluxograma" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Fluxograma e Processos&#x0a;Adicione etapas, decisões e pontos de início/fim ao Workspace.">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.ShapeDiamond}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideFluxograma" Text="Fluxograma" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
                      <MenuItem Header="Adicionar Retângulo (Etapa / Processo)" Click="AdicionarFormaRetangulo_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ShapeRect}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Adicionar Losango (Decisão / Condição)" Click="AdicionarFormaLosango_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ShapeDiamond}"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Adicionar Círculo (Início / Fim)" Click="AdicionarFormaCirculo_Click">
                        <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ShapeCircle}"/></MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Barra Lateral Direita do Calendário -->
        <Border Name="RightCalendarBar" DockPanel.Dock="Right" Width="46" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0">
          <StackPanel Orientation="Vertical" Spacing="6" Margin="5,8">
            <Button Name="BtnRightCalendario" Height="38" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Calendário de Etapas&#x0a;Selecione dias ou arraste um período para planejar etapas, marcar horários, consultar feriados nacionais e vincular janelas ou itens de lista." Click="ToggleCalendarPanel_Click">
              <PathIcon Data="{x:Static local:AppIcons.Calendar}" Width="18" Height="18" Foreground="#CBD5E1"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- Painel Retrátil do Calendário à Direita -->
        <Border Name="RightCalendarPanel" DockPanel.Dock="Right" Width="0" ClipToBounds="True" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.20" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <ContentControl Name="RightCalendarContentHost" Width="300"/>
        </Border>

        <!-- Barra Inferior Unificada: Barra de Tarefas + Menu de Fluxograma e Zoom -->
        <Border Name="BottomBar" DockPanel.Dock="Bottom" Height="42" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <local:TaskBar x:Name="AppTaskBar" Grid.Column="0" BorderThickness="0"/>

            <Border Name="WorkspaceHud"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Padding="5,3"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="#1E293B"
                    BorderBrush="#334155">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Name="BtnHudZoomOut"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="5"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Diminuir Zoom do Workspace (Zoom Out para caber mais janelas)"
                        Click="WorkspaceZoomOut_Click">
                  <PathIcon Data="{x:Static local:AppIcons.Minus}" Width="11" Height="11" Foreground="#CBD5E1"/>
                </Button>
                <Button Name="BtnHudZoomReset"
                        Content="100%"
                        MinWidth="52"
                        Height="26"
                        Padding="6,0"
                        CornerRadius="5"
                        BorderThickness="1"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Clique para redefinir o zoom do Workspace para 100%"
                        Click="WorkspaceZoomReset_Click"/>
                <Button Name="BtnHudZoomIn"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="5"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Aumentar Zoom do Workspace (Zoom In)"
                        Click="WorkspaceZoomIn_Click">
                  <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="11" Height="11" Foreground="#CBD5E1"/>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Área Principal do Workspace com Suporte a Zoom Out/In e Fluxograma -->
        <Grid Name="WorkspaceViewport" ClipToBounds="True">
          <ScrollViewer Name="WorkspaceScroller"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <LayoutTransformControl Name="WorkspaceZoomHost"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
              <Canvas Name="Workspace" Background="#0F172A" ClipToBounds="True"/>
            </LayoutTransformControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- Overlay Modal (Confirmação de Saída e Criação/Renomeação de Workspace) -->
      <Border Name="ModalOverlay" IsVisible="False" Background="#AA090D16" ZIndex="9999">
        <Border Name="ModalCard"
                Width="430"
                Padding="22"
                CornerRadius="10"
                BorderThickness="1"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Name="ModalTitle"
                       Text="Confirmar ação"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"/>
            <TextBlock Name="ModalMessage"
                       Text=""
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="#CBD5E1"/>
            <TextBox Name="ModalInputBox"
                     IsVisible="False"
                     Padding="10,7"
                     CornerRadius="6"
                     FontSize="13"/>
            <StackPanel Name="ModalButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </LayoutTransformControl>
</Window>
