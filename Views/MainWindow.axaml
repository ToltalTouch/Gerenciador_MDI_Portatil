<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaMdiApp"
        x:Class="AvaloniaMdiApp.MainWindow"
        Title="Gerenciador MDI Portátil"
        Icon="avares://AvaloniaMdiApp/Assets/app-icon.png"
        Width="1024" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="MenuItem > PathIcon">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
    </Style>
    <Style Selector="Button.sideSubItem">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.sideSubItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#27272A"/>
    </Style>
  </Window.Styles>

  <LayoutTransformControl Name="RootScaleHost">
    <Grid Name="MainRootGrid">
      <DockPanel Name="RootDock" Background="#0F172A">
        <Border Name="TopBar" DockPanel.Dock="Top" Height="38" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1">
          <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Name="ColorFilterPanel" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Name="LblColorFilter" Text="Filtro:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
              <Button Name="BtnClearColorFilter" Content="Todas" Height="22" Padding="8,0" FontSize="11" CornerRadius="11" Click="ClearColorFilter_Click"/>
              <StackPanel Name="ColorFilterDotsPanel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Abas rápidas de Workspaces à direita -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="520">
                <StackPanel Name="WorkspaceTabsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
              </ScrollViewer>
              <Button Name="BtnAddWorkspace"
                      Height="26"
                      Padding="8,0"
                      CornerRadius="5"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="Criar novo Workspace"
                      Click="NovoWorkspace_Click">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="10" Height="10" Foreground="#CBD5E1"/>
                  <TextBlock Text="Novo Workspace" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Barra Lateral Retrátil de Widgets -->
        <Border Name="LeftSidebar" DockPanel.Dock="Left" Width="60" ClipToBounds="True" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <DockPanel>
            <Button Name="BtnToggleSidebar"
                    DockPanel.Dock="Top"
                    Height="40"
                    Margin="6,8,6,4"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Alternar Menu Lateral&#x0a;Expanda para exibir os nomes de todos os widgets ou recolha para modo compacto com ícones."
                    Click="ToggleSidebar_Click">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{x:Static local:AppIcons.Menu}" Width="18" Height="18" Foreground="#CBD5E1"/>
                <TextBlock Name="LblSidebarTitle" Text="Widgets" FontSize="13" FontWeight="SemiBold" IsVisible="False" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border DockPanel.Dock="Top" Height="1" Margin="10,2,10,6" Background="#27272A"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Spacing="4" Margin="6,4,6,8">
              <Border Height="1" Margin="4,0,4,4" Background="#27272A"/>
              <Button Name="BtnSideSalvarTudo" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Salvar Tudo&#x0a;Salva instantaneamente o estado de todas as janelas, notas, planilhas e o Workspace atual." Click="SalvarTodasJanelas_Click">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Save}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSideSalvarTudo" Text="Salvar Tudo" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Name="BtnSideExtrair" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Central de Exportação e Importação&#x0a;Exporte o Workspace em PDF, PNG, HTML interativo ou pacote portátil (.mdiws/.zip), e importe notas, planilhas e mídias.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Download}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSideExtrair" Text="Exportar / Extrair" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="RightEdgeAlignedBottom">
                    <MenuItem Header="Demonstração em PDF..." Click="ExportarWorkspacePdf_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.PdfFile}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Imagem do Workspace (.png)..." Click="ExportarWorkspacePng_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Image}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Relatório Interativo (.html)..." Click="ExportarWorkspaceHtml_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Globe}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Extrair Janela Ativa (.txt / .csv / Mídia)..." Click="ExportarJanelaAtiva_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ExternalLink}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exportar Workspace (.mdiws)..." Click="ExportarWorkspaceJson_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Download}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exportar Pacote Completo com Mídias (.zip)..." Click="ExportarWorkspaceZip_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Save}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Importar Arquivo para o Workspace (.txt, .csv, Mídia)..." Click="ImportarArquivoParaWorkspace_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Upload}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Importar Workspace / Pacote (.mdiws, .zip)..." Click="ImportarWorkspace_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Folder}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Sincronizar Backup no Google Drive..." Click="SincronizarGoogleDriveManual_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Upload}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Abrir Pasta do Google Drive" Click="AbrirPastaGoogleDrive_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.ExternalLink}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Histórico de Notificações..." Click="AbrirHistoricoNotificacoes_Click">
                      <MenuItem.Icon><PathIcon Data="{x:Static local:AppIcons.Bell}"/></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <Button Name="BtnSideAjuda" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Guia de Uso &amp; Ajuda Interativa&#x0a;Aprenda passo a passo como usar cada recurso do app com exemplos práticos interativos!" Click="AbrirAjudaTutorial_Click">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Help}" Width="18" Height="18" Foreground="#38BDF8"/>
                  <TextBlock Name="LblSideAjuda" Text="Ajuda &amp; Tutorial" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Name="BtnSidePreferencias" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Preferências do Sistema&#x0a;Ajuste o tema visual (claro/escuro e cores), notificações, escala de exibição, tamanho das janelas e atualizações." Click="AbrirConfiguracoes_Click">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <PathIcon Data="{x:Static local:AppIcons.Settings}" Width="18" Height="18" Foreground="#CBD5E1"/>
                  <TextBlock Name="LblSidePreferencias" Text="Preferências" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Vertical" Spacing="6" Margin="6,2,6,8">
                <Button Name="BtnSideNotas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Bloco de Notas&#x0a;Crie anotações com suporte a formatação avançada (negrito, itálico, tamanhos de fonte) por linha e salvamento no Workspace." Click="AbrirBlocoDeNotas_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Note}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideNotas" Text="Bloco de Notas" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Name="BtnSideListas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Lista de Marcação&#x0a;Gerencie tarefas com caixas de seleção, defina cores individuais por item e conecte tarefas a anotações ou datas no calendário." Click="AbrirChecklist_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Checklist}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSideListas" Text="Lista de Marcação" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <Button Name="BtnSidePlanilhas" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Planilhas&#x0a;Grade de cálculo interativa com suporte a fórmulas matemáticas (SOMA, MÉDIA, etc.), formatação condicional e exportação/importação CSV." Click="AbrirPlanilha_Click">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static local:AppIcons.Spreadsheet}" Width="18" Height="18" Foreground="#CBD5E1"/>
                    <TextBlock Name="LblSidePlanilhas" Text="Planilhas" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <!-- Galeria (Accordion Dropdown) -->
                <Button Name="BtnSideGaleria" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="Galeria de Mídias&#x0a;Clique para expandir as opções de imagens e vídeos." Click="ToggleDropdownGaleria_Click">
                  <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Image}" Width="18" Height="18" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="LblSideGaleria" Text="Galeria" FontSize="13" Margin="12,0,0,0" IsVisible="False" VerticalAlignment="Center"/>
                    <PathIcon Grid.Column="2" Name="ChevronSideGaleria" Data="{x:Static local:AppIcons.ChevronDown}" Width="10" Height="10" Foreground="#94A3B8" IsVisible="False" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  </Grid>
                </Button>
                <!-- Submenu Galeria com linha guia vertical -->
                <Border Name="PanelSubmenuGaleria" IsVisible="False" ClipToBounds="True" MaxHeight="0" Opacity="0" Margin="22,1,4,4" BorderBrush="#334155" BorderThickness="1.5,0,0,0" Padding="8,2,0,2">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut"/>
                    </Transitions>
                  </Border.Transitions>
                  <StackPanel Orientation="Vertical" Spacing="2">
                    <Button Classes="sideSubItem" Click="AbrirGaleria_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Nova Galeria" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirImagemAvulsa_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Image}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Abrir Imagem em Janela" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirVideoAvulso_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Video}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Abrir Vídeo em Janela" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Navegador Web (Accordion Dropdown) -->
                <Button Name="BtnSideNavegador" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="Navegador Web&#x0a;Clique para expandir os atalhos e novo navegador." Click="ToggleDropdownNavegador_Click">
                  <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.Globe}" Width="18" Height="18" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="LblSideNavegador" Text="Navegador" FontSize="13" Margin="12,0,0,0" IsVisible="False" VerticalAlignment="Center"/>
                    <PathIcon Grid.Column="2" Name="ChevronSideNavegador" Data="{x:Static local:AppIcons.ChevronDown}" Width="10" Height="10" Foreground="#94A3B8" IsVisible="False" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  </Grid>
                </Button>
                <!-- Submenu Navegador com linha guia vertical -->
                <Border Name="PanelSubmenuNavegador" IsVisible="False" ClipToBounds="True" MaxHeight="0" Opacity="0" Margin="22,1,4,4" BorderBrush="#334155" BorderThickness="1.5,0,0,0" Padding="8,2,0,2">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut"/>
                    </Transitions>
                  </Border.Transitions>
                  <StackPanel Orientation="Vertical" Spacing="2">
                    <Button Classes="sideSubItem" Click="AbrirNavegador_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Novo Navegador" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirNavegadorGoogle_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Search}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Google" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirNavegadorYouTube_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Play}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="YouTube" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirNavegadorGitHub_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Code}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="GitHub" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AbrirNavegadorWikipedia_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.Book}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Wikipédia" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Fluxograma (Accordion Dropdown) -->
                <Button Name="BtnSideFluxograma" Height="40" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="Fluxograma e Processos&#x0a;Clique para expandir as formas de processos e decisões." Click="ToggleDropdownFluxograma_Click">
                  <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Data="{x:Static local:AppIcons.ShapeDiamond}" Width="18" Height="18" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="LblSideFluxograma" Text="Fluxograma" FontSize="13" Margin="12,0,0,0" IsVisible="False" VerticalAlignment="Center"/>
                    <PathIcon Grid.Column="2" Name="ChevronSideFluxograma" Data="{x:Static local:AppIcons.ChevronDown}" Width="10" Height="10" Foreground="#94A3B8" IsVisible="False" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  </Grid>
                </Button>
                <!-- Submenu Fluxograma com linha guia vertical -->
                <Border Name="PanelSubmenuFluxograma" IsVisible="False" ClipToBounds="True" MaxHeight="0" Opacity="0" Margin="22,1,4,4" BorderBrush="#334155" BorderThickness="1.5,0,0,0" Padding="8,2,0,2">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut"/>
                    </Transitions>
                  </Border.Transitions>
                  <StackPanel Orientation="Vertical" Spacing="2">
                    <Button Classes="sideSubItem" Click="AdicionarFormaRetangulo_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.ShapeRect}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Processo (Retângulo)" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AdicionarFormaLosango_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.ShapeDiamond}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Decisão (Losango)" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="sideSubItem" Click="AdicionarFormaCirculo_Click">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static local:AppIcons.ShapeCircle}" Width="10" Height="10" Foreground="#38BDF8"/>
                        <TextBlock Text="Início / Fim (Círculo)" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Barra Lateral Direita do Calendário -->
        <Border Name="RightCalendarBar" DockPanel.Dock="Right" Width="46" ClipToBounds="True" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Orientation="Vertical" Spacing="6" Margin="5,8">
            <Button Name="BtnRightCalendario" Height="38" Padding="10,0" Background="Transparent" BorderThickness="0" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTip.Tip="Calendário de Etapas&#x0a;Selecione dias ou arraste um período para planejar etapas, marcar horários, consultar feriados nacionais e vincular janelas ou itens de lista." Click="ToggleCalendarPanel_Click">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{x:Static local:AppIcons.Calendar}" Width="18" Height="18" Foreground="#CBD5E1"/>
                <TextBlock Name="LblRightCalendario" Text="Calendário" FontSize="13" IsVisible="False" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Painel Retrátil do Calendário à Direita -->
        <Border Name="RightCalendarPanel" DockPanel.Dock="Right" Width="0" ClipToBounds="True" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,0,0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.20" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <ContentControl Name="RightCalendarContentHost" Width="300"/>
        </Border>

        <!-- Barra Inferior Unificada: Barra de Tarefas + Menu de Fluxograma e Zoom -->
        <Border Name="BottomBar" DockPanel.Dock="Bottom" Height="42" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <local:TaskBar x:Name="AppTaskBar" Grid.Column="0" BorderThickness="0"/>

            <Border Name="WorkspaceHud"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Padding="5,3"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="#1E293B"
                    BorderBrush="#334155">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Name="BtnHudZoomOut"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="5"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Diminuir Zoom do Workspace (Zoom Out para caber mais janelas)"
                        Click="WorkspaceZoomOut_Click">
                  <PathIcon Data="{x:Static local:AppIcons.Minus}" Width="11" Height="11" Foreground="#CBD5E1"/>
                </Button>
                <Button Name="BtnHudZoomReset"
                        Content="100%"
                        MinWidth="52"
                        Height="26"
                        Padding="6,0"
                        CornerRadius="5"
                        BorderThickness="1"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Clique para redefinir o zoom do Workspace para 100%"
                        Click="WorkspaceZoomReset_Click"/>
                <Button Name="BtnHudZoomIn"
                        Width="26"
                        Height="26"
                        Padding="0"
                        CornerRadius="5"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Aumentar Zoom do Workspace (Zoom In)"
                        Click="WorkspaceZoomIn_Click">
                  <PathIcon Data="{x:Static local:AppIcons.Plus}" Width="11" Height="11" Foreground="#CBD5E1"/>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Área Principal do Workspace com Suporte a Zoom Out/In e Fluxograma -->
        <Grid Name="WorkspaceViewport" ClipToBounds="True">
          <ScrollViewer Name="WorkspaceScroller"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <LayoutTransformControl Name="WorkspaceZoomHost"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
              <Canvas Name="Workspace" Background="#0F172A" ClipToBounds="True" Focusable="True"/>
            </LayoutTransformControl>
          </ScrollViewer>

          <!-- Overlay para Menu Circular / Radial (Estilo The Sims 4 - Contido no Quadro do Workspace) -->
          <Panel Name="RadialMenuOverlay" IsVisible="False" Background="#01000000" ZIndex="9800">
            <Canvas Name="RadialMenuCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Panel>
        </Grid>
      </DockPanel>

      <!-- Overlay Modal (Confirmação de Saída e Criação/Renomeação de Workspace) -->
      <Border Name="ModalOverlay" IsVisible="False" Background="#AA090D16" ZIndex="9999">
        <Border Name="ModalCard"
                Width="430"
                Padding="22"
                CornerRadius="10"
                BorderThickness="1"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Name="ModalTitle"
                       Text="Confirmar ação"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"/>
            <TextBlock Name="ModalMessage"
                       Text=""
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="#CBD5E1"/>
            <TextBox Name="ModalInputBox"
                     IsVisible="False"
                     Padding="10,7"
                     CornerRadius="6"
                     FontSize="13"/>
            <CheckBox Name="ModalCheckBox"
                      IsVisible="False"
                      Content="Salvar minha resposta"
                      FontSize="12"
                      Margin="0,4,0,0"/>
            <StackPanel Name="ModalButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </LayoutTransformControl>
</Window>
