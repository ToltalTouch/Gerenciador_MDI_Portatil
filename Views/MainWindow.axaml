<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaMdiApp"
        x:Class="AvaloniaMdiApp.MainWindow"
        Title="Gerenciador MDI Portátil"
        Width="1024" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  
  <DockPanel Name="RootDock" Background="#0F172A">
    <Border Name="TopBar" DockPanel.Dock="Top" Height="54" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="10" Height="22" CornerRadius="3" Background="#2563EB" VerticalAlignment="Center"/>
          <TextBlock Name="AppTitleText" Text="MDI Workspace" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" VerticalAlignment="Center"/>
          <Border Name="TitleDivider" Width="1" Height="20" Background="#334155" Margin="4,0" VerticalAlignment="Center"/>
          <Button Name="BtnWidgets"
                  Content="🧩 Widgets ▾"
                  Background="#334155"
                  Foreground="#F8FAFC"
                  FontWeight="SemiBold"
                  FontSize="12.5"
                  Padding="12,7"
                  CornerRadius="6"
                  VerticalAlignment="Center">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="MenuWidgets_Opening">
                <MenuItem Header="📝 Novo Bloco de Notas" Click="AbrirBlocoDeNotas_Click"/>
                <MenuItem Header="☑ Nova Lista de Marcação" Click="AbrirChecklist_Click"/>
                <MenuItem Header="🌐 Novo Navegador Web" Click="AbrirNavegador_Click"/>
                <Separator/>
                <MenuItem Header="💾 Salvar Janela Ativa" Click="SalvarJanelaAtiva_Click"/>
                <MenuItem Header="💾 Salvar Todas as Janelas" Click="SalvarTodasJanelas_Click"/>
                <Separator/>
                <MenuItem Name="MenuMaisUsadas" Header="⭐ Mais Usadas"/>
                <MenuItem Name="MenuJanelasSalvas" Header="📂 Janelas Salvas"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="BtnCascata"
                  Content="❐ Cascata"
                  Background="#334155"
                  Foreground="#F8FAFC"
                  FontSize="12.5"
                  Padding="12,7"
                  CornerRadius="6"
                  Click="OrganizarCascata_Click"/>
          <Button Name="BtnLadoALado"
                  Content="⊞ Grade"
                  Background="#334155"
                  Foreground="#F8FAFC"
                  FontSize="12.5"
                  Padding="12,7"
                  CornerRadius="6"
                  Click="OrganizarGrade_Click"/>
          <Button Name="BtnConfiguracoes"
                  Content="⚙ Preferências"
                  Background="#334155"
                  Foreground="#F8FAFC"
                  FontSize="12.5"
                  Padding="12,7"
                  CornerRadius="6"
                  Click="AbrirConfiguracoes_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <local:TaskBar x:Name="AppTaskBar" DockPanel.Dock="Bottom"/>

    <Canvas Name="Workspace" Background="#0F172A" ClipToBounds="True"/>
  </DockPanel>
</Window>
